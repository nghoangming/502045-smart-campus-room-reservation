 absence_requests | absence_requests_insert_policy | INSERT |                                                                                                                                                                                                                                          | ((user_id = app_current_user_id()) AND ((((request_type)::text = 'TEACHER'::text) AND (app_current_role() = 'TEACHER'::text) AND (EXISTS ( SELECT 1                                                                          +
                  |                                |        |                                                                                                                                                                                                                                          |    FROM (class_sessions cs                                                                                                                                                                                                   +
                  |                                |        |                                                                                                                                                                                                                                          |      JOIN bookings b ON ((b.booking_id = cs.booking_id)))                                                                                                                                                                    +
                  |                                |        |                                                                                                                                                                                                                                          |   WHERE ((cs.class_session_id = absence_requests.class_session_id) AND (b.user_id = app_current_user_id()))))) OR (((request_type)::text = 'STUDENT'::text) AND (app_current_role() = 'STUDENT'::text) AND (EXISTS ( SELECT 1+
                  |                                |        |                                                                                                                                                                                                                                          |    FROM (class_sessions cs                                                                                                                                                                                                   +
