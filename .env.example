# These are process environment variables; Spring Boot does not load this file automatically.
# backend/Run-Local.ps1 asks for the database password without saving it.
DB_URL=jdbc:postgresql://localhost:5432/CNPM
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgresql-password
SPRING_PROFILES_ACTIVE=dev
# Tables, roles, indexes and seed are applied manually in pgAdmin.
SPRING_FLYWAY_ENABLED=false
# Required outside dev; use a random secret of at least 32 bytes.
AUTH_JWT_SECRET=replace-with-a-long-random-secret-before-deploying
